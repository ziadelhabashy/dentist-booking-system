# Copy this file to .env and update the values for your environment.
# Do NOT commit .env to Git — it contains secrets.

PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?appName=<appName>
# Optional: use alternate DNS servers for mongodb+srv SRV lookups (Windows/local DNS issues).
# Leave unset to use system DNS. Example: 8.8.8.8,1.1.1.1
# MONGODB_DNS_SERVERS=
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
NODE_ENV=development
ADMIN_NAME=Dr. Sara Galal
ADMIN_EMAIL=admin@drsaragalal.com
ADMIN_PASSWORD=change_me_after_first_login
FRONTEND_URL=http://localhost:5500
